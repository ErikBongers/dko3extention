{
  "name": "dko3extention",
  "version": "1.0.0",
  "description": "This extension only works with the Belgian DKO3 public art school software.",
  "main": "typescript/plugin_options/options_page.ts",
  "scripts": {
    "test": "echo \"Note that the build command does a TSC first for stricter compilation.\" && exit 1",
    "build_all": "npm run build_content && npm run build_options && npm run build_serviceworker && npm run build_blank && npm run build_hours_setup && npm run build_diff_settings",
    "build_all_quick": "rolldown -c rolldown_all.config.ts",
    "build_content": "tsc --build &&  rolldown -c",
    "build_serviceworker": "tsc --project ./tsconfig_service.json &&  rolldown -c rolldown_service.config.ts",
    "build_aiworker": "tsc --project ./tsconfig_ai_worker.json &&  rolldown -c rolldown_ai_worker.config.ts",
    "build_options": "tsc --project ./tsconfig_options.json && rolldown -c rolldown_options.config.ts",
    "build_blank": "tsc --project ./tsconfig_blank.json && rolldown -c rolldown_blank.config.ts",
    "build_hours_setup": "tsc --project ./tsconfig_teacher_hours_setup.json && rolldown -c rolldown_hours_setup.config.ts",
    "build_diff_settings": "tsc --project ./tsconfig_diff_settings.json && rolldown -c rolldown_diff_settings.config.ts",
    "publish_edge": "powershell ./zip.ps1",
    "download_mBERT": "node scripts/download_hugging_model.js Xenova/bert-base-NER",
    "download_multilangBERT": "node scripts/download_hugging_model.js onnx-community/bert-base-multilingual-cased-ner-hrl-ONNX"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.0.313",
    "rolldown": "^1.2.6",
    "rollup-plugin-copy": "^3.5.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "idb": "^8.0.3"
  }
}
